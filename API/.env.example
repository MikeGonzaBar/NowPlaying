DJANGO_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-development-secret
# Development-only sample Fernet key. Generate a unique key for real environments.
API_KEY_ENCRYPTION_KEY=C3fygP72WNfaeLgDXCwPRgxSzWQctoCY7fHB3DNOZPM=
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3200
CORS_ALLOW_ALL_ORIGINS=false
# Route gates. Docker Compose overrides these per API service.
ENABLE_ADMIN_SITE=true
ENABLE_API_DOCS=true
RUN_MIGRATIONS=true
STATIC_ROOT=

# --- Supabase Postgres (the ONLY supported database) ---
# Point SUPABASE_DB_HOST at either the local CLI stack (127.0.0.1, port 54322,
# started with `supabase start`) or the hosted project pooler
# (aws-0-<region>.pooler.supabase.com, TLS is enabled automatically for any
# host containing "supabase"). The API fails fast if these are missing.
SUPABASE_DB_HOST=127.0.0.1
SUPABASE_DB_PORT=54322
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
# The local `supabase start` stack ships with a default development password;
# use the project's database password when pointing at a hosted Supabase host.
SUPABASE_DB_PASSWORD=replace-with-your-db-password

# Tests: `manage.py test` refuses to target a hosted Supabase host, because it
# would create and drop a throwaway database on the real project. Run the suite
# against the local stack configured above, or set ALLOW_REMOTE_TESTS=1 when you
# deliberately point at a scratch Supabase project.
# ALLOW_REMOTE_TESTS=

# Supabase platform keys (PostgREST / Auth / Edge Functions surface).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Optional. If unset, the API derives the callback URL from the incoming request.
# With the default Docker UI proxy, set the Trakt app redirect to:
# http://<ui-host>:3200/api/trakt/oauth-callback/
# If you bypass the UI proxy, set this to the exact API callback instead.
TRAKT_REDIRECT_URI=
TMDB_API_KEY=replace-with-tmdb-api-key
